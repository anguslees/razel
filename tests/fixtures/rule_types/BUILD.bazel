load(":defs.bzl", "all_types_rule", "sample_binary", "sample_test")

all_types_rule(
    name = "typed",
    flag = False,
    count = 7,
    counts = [2, 3],
    text = "explicit",
    strings = ["one", "two"],
    string_map = {"one": "two"},
    string_lists = {"one": ["two", "three"]},
    dep = "missing_dep.txt",
    deps = [Label(":missing_list_dep.txt")],
    keyed_strings = {":missing_key_dep.txt": "value"},
    grouped_deps = {"group": [":missing_list_dict_dep.txt"]},
    named_deps = {"dep": Label(":missing_string_keyed_dep.txt")},
    out = "typed.out",
    outs = ["typed_a.out", "typed_b.out"],
)

sample_binary(
    name = "binary",
    args = ["--flag"],
    env = {"KEY": "value"},
)

sample_test(
    name = "test",
    size = "small",
    flaky = True,
)
